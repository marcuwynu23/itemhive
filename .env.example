# =============================================================================
# ItemHive Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection String
# For local MongoDB installation:
MONGODB_URI="mongodb://localhost:27017/itemhive"

# For MongoDB Atlas (cloud):
# MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/itemhive?retryWrites=true&w=majority"

# =============================================================================
# NEXTAUTH CONFIGURATION
# =============================================================================

# NextAuth URL - The canonical URL of your site
# In development:
NEXTAUTH_URL="http://localhost:3000"

# In production:
# NEXTAUTH_URL="https://yourdomain.com"

# NextAuth Secret - Used to encrypt JWT tokens
# Generate a random secret: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-super-secret-jwt-key-change-this-in-production"

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node Environment
NODE_ENV="development"

# Application Port (optional, defaults to 3000)
PORT=3000

# =============================================================================
# OPTIONAL: EMAIL CONFIGURATION (for future features)
# =============================================================================

# Email service configuration (for password reset, notifications, etc.)
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT=587
# EMAIL_SERVER_USER="your-email@gmail.com"
# EMAIL_SERVER_PASSWORD="your-app-password"
# EMAIL_FROM="noreply@itemhive.com"

# =============================================================================
# OPTIONAL: CLOUD STORAGE (for future features)
# =============================================================================

# AWS S3 Configuration (for file uploads, backups, etc.)
# AWS_ACCESS_KEY_ID="your-access-key"
# AWS_SECRET_ACCESS_KEY="your-secret-key"
# AWS_REGION="us-east-1"
# AWS_S3_BUCKET="itemhive-uploads"

# =============================================================================
# OPTIONAL: EXTERNAL SERVICES (for future features)
# =============================================================================

# Stripe Configuration (for payment processing)
# STRIPE_PUBLIC_KEY="pk_test_..."
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# SendGrid Configuration (for email notifications)
# SENDGRID_API_KEY="SG...."

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Enable debug logging
# DEBUG="itemhive:*"

# Disable telemetry
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Origins (comma-separated list)
# CORS_ORIGINS="http://localhost:3000,https://yourdomain.com"

# Rate limiting
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000

# =============================================================================
# NOTES
# =============================================================================
# 
# Required Variables:
# - DATABASE_URL or MONGODB_URI (one is required)
# - NEXTAUTH_URL
# - NEXTAUTH_SECRET
#
# Optional Variables:
# - All others are optional and for future features
#
# Security Notes:
# - Never commit .env to version control
# - Use strong, unique secrets in production
# - Rotate secrets regularly
# - Use environment-specific values
#
# MongoDB Connection Examples:
# - Local: mongodb://localhost:27017/itemhive
# - Atlas: mongodb+srv://user:pass@cluster.mongodb.net/itemhive
# - Docker: mongodb://mongo:27017/itemhive
#
# Generate Secrets:
# - NEXTAUTH_SECRET: openssl rand -base64 32
# - Or use online generator: https://generate-secret.vercel.app/32
#